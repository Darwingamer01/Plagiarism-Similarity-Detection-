# Environment
ENVIRONMENT=development

# Model Configuration
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODEL_CACHE_DIR=/app/models
DATA_DIR=/app/data

# Document Processing
CHUNK_SIZE=300
CHUNK_OVERLAP=50
MAX_FILE_SIZE=5242880

# FAISS Configuration
FAISS_INDEX_TYPE=FlatL2
FAISS_NLIST=100

# Server
HOST=0.0.0.0
PORT=8001

# Logging
LOG_LEVEL=INFO
