FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create non-root user (id 1000 is required by HF Spaces)
RUN useradd -m -u 1000 appuser

# Create data directories with permissions
RUN mkdir -p /app/data/faiss_index /app/data/documents /app/models /home/appuser/.cache/huggingface && \
    chown -R appuser:appuser /app/data /app/models /home/appuser /app

USER appuser

# Expose port 7860 (Hugging Face default)
EXPOSE 7860

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=5 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:7860/health || exit 1

# Start application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860"]
