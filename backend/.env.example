# Environment
NODE_ENV=development

# Server
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://plagiarism_user:plagiarism_pass_2024@localhost:5432/plagiarism_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plagiarism_db
DB_USER=plagiarism_user
DB_PASSWORD=plagiarism_pass_2024
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=60000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=.txt,.pdf,.docx
MAX_FILES_PER_UPLOAD=10

# Security
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# API
API_PREFIX=/api
API_VERSION=v1

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here
APPLE_CLIENT_ID=your-apple-service-id-here
APPLE_TEAM_ID=your-apple-team-id-here
APPLE_KEY_ID=your-apple-key-id-here
APPLE_PRIVATE_KEY_PATH=./keys/apple-private-key.p8
FRONTEND_URL=http://localhost:3000
